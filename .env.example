# ==========================================
# Ecoesse Commerce Engine - Environment Variables
# ==========================================

# Client Firebase Configuration (Required for Next.js Browser Client)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Server-Side Firebase Admin (Optional for local dev, used in server actions & webhooks)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Stripe Payments & Webhooks (CAD default currency, GST/QST enabled)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Greenspark API (Impact Verification: Trees, Ocean Plastic, Carbon)
GREENSPARK_API_KEY=your_greenspark_api_key
# Task M-02 — production Greenspark settings (all optional, with defaults
# in src/lib/greenspark/client.ts). In production, a failed Greenspark
# call is recorded as "pending" and retried via Stripe redelivery — it is
# never replaced with a fabricated transaction id. The dev mock fallback
# runs only when no real key is set and NODE_ENV is not "production".
GREENSPARK_API_BASE_URL=https://api.getgreenspark.com
GREENSPARK_MAX_ATTEMPTS=4
GREENSPARK_RETRY_BASE_DELAY_MS=1000
GREENSPARK_TIMEOUT_MS=10000
# Incoming Greenspark webhook (POST /api/webhooks/greenspark). Leave unset
# to keep that endpoint disabled (503). Only set it after confirming
# Greenspark's webhook header name and payload format in its dashboard —
# see src/lib/greenspark/webhook.ts. The endpoint verifies every request
# with HMAC-SHA256 over the raw body and fails closed without this secret.
GREENSPARK_WEBHOOK_SECRET=

# Storefront URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
